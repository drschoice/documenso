{
  "image": "PLACEHOLDER_IMAGE_REPLACED_BY_CI",
  "containerPort": 3000,
  "awsLogsConfiguration": {
    "logGroup": "/ecs/documenso",
    "logStreamPrefix": "ecs"
  },
  "environment": [
    { "name": "NODE_ENV", "value": "production" },
    { "name": "PORT", "value": "3000" },
    { "name": "NEXT_PRIVATE_INTERNAL_WEBAPP_URL", "value": "http://localhost:3000" },
    { "name": "NEXT_PRIVATE_SIGNING_TRANSPORT", "value": "local" }
  ],
  "secrets": [
    { "name": "NEXTAUTH_SECRET", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXTAUTH_SECRET::" },
    { "name": "NEXT_PRIVATE_ENCRYPTION_KEY", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_ENCRYPTION_KEY::" },
    { "name": "NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY::" },
    { "name": "NEXT_PRIVATE_DATABASE_URL", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_DATABASE_URL::" },
    { "name": "NEXT_PRIVATE_DIRECT_DATABASE_URL", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_DIRECT_DATABASE_URL::" },
    { "name": "NEXT_PUBLIC_WEBAPP_URL", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PUBLIC_WEBAPP_URL::" },
    { "name": "NEXT_PUBLIC_DISABLE_SIGNUP", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PUBLIC_DISABLE_SIGNUP::" },
    { "name": "NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_ALLOWED_SIGNUP_DOMAINS::" },
    { "name": "DOCUMENSO_DISABLE_TELEMETRY", "valueFrom": "REPLACE_WITH_AppSecretArn:DOCUMENSO_DISABLE_TELEMETRY::" },
    { "name": "NEXT_PRIVATE_SMTP_TRANSPORT", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_SMTP_TRANSPORT::" },
    { "name": "NEXT_PRIVATE_SMTP_HOST", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_SMTP_HOST::" },
    { "name": "NEXT_PRIVATE_SMTP_PORT", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_SMTP_PORT::" },
    { "name": "NEXT_PRIVATE_SMTP_USERNAME", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_SMTP_USERNAME::" },
    { "name": "NEXT_PRIVATE_SMTP_PASSWORD", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_SMTP_PASSWORD::" },
    { "name": "NEXT_PRIVATE_SMTP_FROM_NAME", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_SMTP_FROM_NAME::" },
    { "name": "NEXT_PRIVATE_SMTP_FROM_ADDRESS", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_SMTP_FROM_ADDRESS::" },
    { "name": "NEXT_PRIVATE_SIGNING_PASSPHRASE", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_SIGNING_PASSPHRASE::" },
    { "name": "NEXT_PRIVATE_SIGNING_LOCAL_FILE_CONTENTS", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_SIGNING_LOCAL_FILE_CONTENTS::" },
    { "name": "GOOGLE_VERTEX_PROJECT_ID", "valueFrom": "REPLACE_WITH_AppSecretArn:GOOGLE_VERTEX_PROJECT_ID::" },
    { "name": "GOOGLE_VERTEX_API_KEY", "valueFrom": "REPLACE_WITH_AppSecretArn:GOOGLE_VERTEX_API_KEY::" },
    { "name": "GOOGLE_VERTEX_LOCATION", "valueFrom": "REPLACE_WITH_AppSecretArn:GOOGLE_VERTEX_LOCATION::" },
    { "name": "NEXT_PUBLIC_UPLOAD_TRANSPORT", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PUBLIC_UPLOAD_TRANSPORT::" },
    { "name": "NEXT_PRIVATE_UPLOAD_BUCKET", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_UPLOAD_BUCKET::" },
    { "name": "NEXT_PRIVATE_UPLOAD_REGION", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_UPLOAD_REGION::" },
    { "name": "NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID::" },
    { "name": "NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY", "valueFrom": "REPLACE_WITH_AppSecretArn:NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY::" }
  ]
}
